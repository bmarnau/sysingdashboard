# Cross-platform repository text normalization.
# Repository policy overrides developer-local core.autocrlf behavior.
* text=auto eol=lf

# Windows command processor scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never perform text/EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.docx binary
*.xlsx binary
*.pptx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
