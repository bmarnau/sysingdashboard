{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sysingdashboard/contracts/wallboard-management-data/0.1.0-draft/schema.json",
  "title": "Sysing Dashboard - External Management Data Contract",
  "description": "Draft provider-neutral management data contract for the Management-Wallboard. Documentation/contract only; not a production endpoint contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deliveryId",
    "deliveryType",
    "generatedAt",
    "observedAt",
    "producer",
    "scope",
    "completeness",
    "sourceStatus",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0-draft"
    },
    "deliveryId": {
      "type": "string",
      "format": "uuid"
    },
    "deliveryType": {
      "type": "string",
      "enum": ["snapshot"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "sourceStatus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceStatus"
      }
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "instance"],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemhouseId"],
      "properties": {
        "systemhouseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotComplete", "missingDomains"],
      "properties": {
        "snapshotComplete": {
          "type": "boolean"
        },
        "missingDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "projects",
              "workPackages",
              "activities",
              "absence",
              "infrastructure",
              "supportMailbox"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "snapshotComplete": {"const": true}
            },
            "required": ["snapshotComplete"]
          },
          "then": {
            "properties": {
              "missingDomains": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "snapshotComplete": {"const": false}
            },
            "required": ["snapshotComplete"]
          },
          "then": {
            "properties": {
              "missingDomains": {"minItems": 1}
            }
          }
        }
      ]
    },
    "sourceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "state", "observedAt"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["sharepoint", "prtg", "exchange-online"]
        },
        "state": {
          "type": "string",
          "enum": ["ok", "delayed", "stale", "error"]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "code": {
          "type": "string",
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "trafficLight": {
      "type": "string",
      "enum": ["green", "yellow", "red", "neutral"]
    },
    "entityStatus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "title", "status", "trafficLight", "lastChangedAt"],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "status": {
          "$ref": "#/$defs/entityStatus"
        },
        "trafficLight": {
          "$ref": "#/$defs/trafficLight"
        },
        "lastChangedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "workPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "projectSourceId", "title", "status", "trafficLight", "lastChangedAt"],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "projectSourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "status": {
          "$ref": "#/$defs/entityStatus"
        },
        "trafficLight": {
          "$ref": "#/$defs/trafficLight"
        },
        "lastChangedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "workPackageSourceId", "title", "status", "trafficLight", "lastChangedAt"],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "workPackageSourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "status": {
          "$ref": "#/$defs/entityStatus"
        },
        "trafficLight": {
          "$ref": "#/$defs/trafficLight"
        },
        "lastChangedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "absence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["employeesOnLeaveThisWeek", "employeesStartingLeaveNextWeek", "observedAt"],
      "properties": {
        "employeesOnLeaveThisWeek": {
          "type": "integer",
          "minimum": 0
        },
        "employeesStartingLeaveNextWeek": {
          "type": "integer",
          "minimum": 0
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "warning", "critical", "total", "observedAt"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "critical": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "observedAt": {"type": "string", "format": "date-time"}
      }
    },
    "supportMailbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "today", "yesterday", "older", "observedAt"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "today": {"type": "integer", "minimum": 0},
        "yesterday": {"type": "integer", "minimum": 0},
        "older": {"type": "integer", "minimum": 0},
        "observedAt": {"type": "string", "format": "date-time"}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projects": {
          "type": "array",
          "items": {"$ref": "#/$defs/project"}
        },
        "workPackages": {
          "type": "array",
          "items": {"$ref": "#/$defs/workPackage"}
        },
        "activities": {
          "type": "array",
          "items": {"$ref": "#/$defs/activity"}
        },
        "absence": {"$ref": "#/$defs/absence"},
        "infrastructure": {"$ref": "#/$defs/infrastructure"},
        "supportMailbox": {"$ref": "#/$defs/supportMailbox"}
      }
    }
  }
}
